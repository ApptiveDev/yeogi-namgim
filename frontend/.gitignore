# Expo / React Native / TypeScript

# Dependencies and package manager caches
node_modules/
.npm/
.pnpm-store/

# Expo and Metro local state
.expo/
.eas/
.metro-health-check*

# Generated output and type declarations
dist/
web-build/
coverage/
*.tsbuildinfo
expo-env.d.ts

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# Native build caches and local SDK settings
.gradle/
.kotlin/
build/
local.properties
.externalNativeBuild/
.cxx/
DerivedData/
Pods/

# Native build output and signing credentials
*.apk
*.aab
*.ipa
*.hprof
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.orig.*

# my-app/.gitignore handles generated ios/ and android/ directories.
# Keep package-lock.json, app.json, eas.json and assets in Git.
