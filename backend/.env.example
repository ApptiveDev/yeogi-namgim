# Enable member authentication only after SMTP and both independent keys are configured.
AUTH_ENABLED=false
AUTH_JWT_SECRET=
AUTH_VERIFICATION_SECRET=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=14d
# Provisional default; product can adjust invitation expiry without code changes.
FRIEND_INVITATION_TTL=24h
AUTH_MAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
